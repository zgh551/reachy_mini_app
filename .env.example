# ASR (Qwen3-ASR)
ASR_BASE_URL=http://192.168.1.18:8000/v1
ASR_MODEL=./Qwen3-ASR-1.7B

# LLM
LLM_BASE_URL=http://192.168.200.252:30000/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen3.5-27b

# TTS
# Provider: qwen3 (OpenAI-compatible Qwen3-TTS) or breeze (Breeze TTS-2)
TTS_PROVIDER=qwen3

# --- TTS: Qwen3 (used when TTS_PROVIDER=qwen3) ---
TTS_BASE_URL=http://192.168.200.252:8091
TTS_API_KEY=not-needed
TTS_MODEL=./Qwen3-TTS-12Hz-1.7B-VoiceDesign
TTS_VOICE=vivian
TTS_INSTRUCTIONS=自然感的女声，语调活泼带笑意，模仿别人‘嘘’你时压低嗓音，就是平时聊天的感觉

# --- TTS: Breeze TTS-2 (used when TTS_PROVIDER=breeze) ---
BREEZE_TTS_BASE_URL=http://192.168.200.252:7860
BREEZE_TTS_INSTRUCTION=Speak clearly and naturally.
BREEZE_TTS_CFG_SCALE=1.0
BREEZE_TTS_SEED=42
# Optional voice cloning (both must be set together):
# BREEZE_TTS_REF_AUDIO=/path/to/reference.wav
# BREEZE_TTS_REF_TEXT=Exact transcript of the reference audio.
